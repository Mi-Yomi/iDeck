#!/bin/sh
# HOST ACCEPTANCE ONLY: Debian provision kernel, never an iPhone boot entry.
BB=/usr/bin/busybox
export PATH=/run/ideck-bin:/usr/sbin:/usr/bin:/sbin:/bin
fail() { echo "IDECK_GUI_HOST_FAILED:$1"; while :; do $BB sleep 3600; done; }
$BB mkdir -p /proc /sys /dev /run /sysroot
$BB mount -t proc proc /proc || fail proc
$BB mount -t sysfs sysfs /sys || fail sys
$BB mount -t devtmpfs devtmpfs /dev || fail dev
exec </dev/console >/dev/console 2>&1
$BB mkdir -p /run/ideck-bin
$BB --install -s /run/ideck-bin
while IFS= read -r mod; do insmod "/ideck/modules/$mod" || fail "module_$mod"; done < /ideck/gui-load-order
n=0
root_disk=
package_disk=
while [ -z "$root_disk" ] || [ -z "$package_disk" ]; do
    for device in /dev/vd*; do
        [ -b "$device" ] || continue
        case "$(blkid "$device")" in
            *'UUID="b66e1c8d-9cbf-45a7-b97b-dcc8f68efca7"'*) [ -z "$root_disk" ] || [ "$root_disk" = "$device" ] || fail duplicate_root; root_disk=$device ;;
            *'UUID="691da426-5867-4e6e-bcab-dc62b40715b6"'*) [ -z "$package_disk" ] || [ "$package_disk" = "$device" ] || fail duplicate_packages; package_disk=$device ;;
        esac
    done
    n=$((n+1)); [ "$n" -lt 30 ] || fail disk
    [ -n "$root_disk" ] && [ -n "$package_disk" ] || sleep 1
done
mount -t ext4 -o rw "$root_disk" /sysroot || fail root
for name in proc sys dev; do mount -o bind "/$name" "/sysroot/$name" || fail "bind_$name"; done
mkdir -p /dev/pts /dev/shm
mount -t devpts -o newinstance,ptmxmode=0666,mode=0620,gid=5 devpts /sysroot/dev/pts || fail pts
ln -sf pts/ptmx /dev/ptmx
mount -t tmpfs -o mode=1777 tmpfs /sysroot/dev/shm || fail shm
mount -t tmpfs -o mode=0755 tmpfs /sysroot/run || fail run
mount -t ext4 -o ro "$package_disk" /sysroot/packages || fail packages
ln -sf /proc/self/fd /dev/fd
shutdown() {
    trap '' USR2 TERM INT
    kill -TERM -1 || true; sleep 2; kill -KILL -1 || true
    wait 2>/dev/null || true
    sync || fail sync
    for name in packages run dev/shm dev/pts dev sys proc; do umount "/sysroot/$name" || fail "unmount_$name"; done
    umount /sysroot || fail unmount_root
    sync || fail final_sync
    echo IDECK_GUI_HOST_CLEAN_UNMOUNT
    poweroff -f
    fail poweroff
}
trap shutdown USR2 TERM INT
# Independent Stop control, closed to every X client and shell child.
control=
for port in /sys/class/virtio-ports/*; do
    [ -r "$port/name" ] || continue
    if [ "$(cat "$port/name")" = org.ideck.control ]; then control=/dev/${port##*/}; fi
done
[ -c "$control" ] || fail no_control
exec 3<>"$control"
(
    while IFS= read -r command <&3; do
        if [ "$command" = IDECK_STOP_V1 ]; then kill -USR2 1; exit; fi
    done
) &
case "$(cat /proc/cmdline)" in
    *ideck.provision=1*) chroot /sysroot /usr/local/lib/ideck/provision 3>&- || fail configure; shutdown ;;
esac
SYSTEMD_IN_CHROOT=0 chroot /sysroot /usr/lib/systemd/systemd-udevd --daemon 3>&- || fail udevd
SYSTEMD_IN_CHROOT=0 chroot /sysroot udevadm trigger --action=add 3>&- || fail trigger
SYSTEMD_IN_CHROOT=0 chroot /sysroot udevadm settle --timeout=30 3>&- || fail settle
[ -c /dev/dri/card0 ] && [ -c /dev/tty0 ] || fail kms_vt
chroot /sysroot /usr/local/lib/ideck/start 3>&- &
n=0
while [ ! -e /sysroot/run/ideck/gui-ready ]; do sleep 1; n=$((n+1)); [ "$n" -lt 90 ] || fail gui_ready; done
echo IDECK_GUI_HOST_READY
# Serial recovery shell remains available. No serial command is keyboard input.
$BB getty -n -l /ideck-gui-host-login -L 115200 ttyAMA0 dumb 3>&- &
shell_pid=$!
wait "$shell_pid"
shutdown
