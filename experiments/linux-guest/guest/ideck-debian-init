#!/bin/sh
# PID 1 stays in the verified Alpine initramfs; the interactive shell is Debian.
export PATH=/run/ideck-bin:/usr/sbin:/usr/bin:/sbin:/bin
BB=/usr/bin/busybox
stopping=0
mounted=0
control_open=0
fail() {
    echo "IDECK_DEBIAN_FAILED:$1"
    if [ "$control_open" = 1 ]; then echo IDECK_DEBIAN_STOP_FAILED >&3; fi
    # Preserve evidence and ownership. Never format, fsck, or claim clean here.
    while :; do $BB sleep 3600; done
}
shutdown() {
    [ "$stopping" = 0 ] || return
    stopping=1
    trap '' USR2 TERM INT
    # Linux excludes PID 1 from kill(-1); terminate every guest writer first.
    $BB kill -TERM -1 || true
    $BB sleep 2
    $BB kill -KILL -1 || true
    wait 2>/dev/null || true
    $BB sync || fail sync
    [ "$mounted" = 1 ] || fail not_mounted
    for name in run dev sys proc; do
        $BB umount "/sysroot/$name" || fail "unmount_$name"
    done
    $BB umount /sysroot || fail unmount_ext4
    mounted=0
    $BB sync || fail final_sync
    echo IDECK_DEBIAN_CLEAN_UNMOUNT
    echo IDECK_DEBIAN_CLEAN_UNMOUNT >&3
    $BB poweroff -f
    fail poweroff_returned
}
trap shutdown USR2 TERM INT
$BB mkdir -p /proc /sys /dev /run /sysroot || fail directories
$BB mount -t proc proc /proc || fail proc
$BB mount -t sysfs sysfs /sys || fail sysfs
$BB mount -t devtmpfs devtmpfs /dev || fail devtmpfs
exec </dev/console >/dev/console 2>&1
$BB mkdir -p /run/ideck-bin || fail applet_directory
$BB --install -s /run/ideck-bin || fail applet_links
echo IDECK_DEBIAN_BOOT
uname -a || fail uname
modprobe virtio_mmio || fail virtio_mmio
modprobe virtio_blk || fail virtio_blk
while IFS= read -r module; do
    insmod "/lib/modules/6.18.35-0-virt/$module" || fail "insmod_$module"
done < /ideck/ext4-load-order
n=0
control=
while [ "$n" -lt 30 ]; do
    for port in /sys/class/virtio-ports/*; do
        [ -r "$port/name" ] || continue
        if [ "$(cat "$port/name")" = org.ideck.control ]; then control=/dev/${port##*/}; fi
    done
    [ -b /dev/vda ] && [ -c "$control" ] && break
    sleep 1
    n=$((n + 1))
done
[ -b /dev/vda ] || fail no_disk
[ -c "$control" ] || fail no_control
exec 3<>"$control" || fail open_control
control_open=1
mount -t ext4 -o rw /dev/vda /sysroot || fail ext4_mount
mounted=1
for name in proc sys dev; do mount -o bind "/$name" "/sysroot/$name" || fail "bind_$name"; done
mount -t tmpfs tmpfs /sysroot/run || fail run_mount
(
    while IFS= read -r command <&3; do
        if [ "$command" = IDECK_STOP_V1 ]; then kill -USR2 1; exit; fi
    done
) &
echo IDECK_DEBIAN_READY
echo IDECK_DEBIAN_READY >&3
# getty provides a controlling tty and ISIG, without leaking the supervisor FD.
$BB getty -n -l /ideck-debian-login -L 115200 ttyAMA0 dumb 3>&- &
shell_pid=$!
wait "$shell_pid"
shutdown
