 }
+
+/* Complete desktop pointer state. Called only by the serialized input queue.
+ * No runtime teardown, RCU change, or display reinitialization is introduced. */
+bool husk_display_send_pointer_buttons(int32_t x, int32_t y,
+                                      uint32_t buttons, int32_t wheel)
+{
+    QemuConsole *con;
+    int w, h;
+    if ((buttons & ~7u) || wheel < -8 || wheel > 8) {
+        return false;
+    }
+    bql_lock();
+    con = husk_input_console();
+    husk_input_size(con, &w, &h);
+    bool available = con && w > 0 && h > 0;
+    if (available) {
+        x = MAX(0, MIN(x, w - 1));
+        y = MAX(0, MIN(y, h - 1));
+        qemu_input_queue_abs(con, INPUT_AXIS_X, x, 0, w);
+        qemu_input_queue_abs(con, INPUT_AXIS_Y, y, 0, h);
+        qemu_input_queue_btn(con, INPUT_BUTTON_LEFT, (buttons & 1) != 0);
+        qemu_input_queue_btn(con, INPUT_BUTTON_RIGHT, (buttons & 2) != 0);
+        qemu_input_queue_btn(con, INPUT_BUTTON_MIDDLE, (buttons & 4) != 0);
+        qemu_input_event_sync();
+        InputButton direction = wheel > 0 ? INPUT_BUTTON_WHEEL_UP : INPUT_BUTTON_WHEEL_DOWN;
+        for (int i = 0; i < abs(wheel); i++) {
+            qemu_input_queue_btn(con, direction, true);
+            qemu_input_event_sync();
+            qemu_input_queue_btn(con, direction, false);
+            qemu_input_event_sync();
+        }
+    }
+    bql_unlock();
+    return available;
+}
